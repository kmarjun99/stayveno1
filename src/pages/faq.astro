---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { FAQ_CATEGORIES, ALL_FAQS } from '../data/faqs';
import { breadcrumbSchema, faqSchema } from '../lib/seo';

const waHref = `https://wa.me/${site.whatsapp.number}`;
---
<BaseLayout
  title="Student Accommodation FAQ — Booking, Costs, Visas & Viewings"
  description="Answers on how Stay Veno works: costs and commission, video tours and viewings, contracts and guarantors, visas, deposits and arrival. Free student accommodation help for the UK, Germany, Ireland and Canada."
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'FAQ', path: '/faq' },
    ]),
    faqSchema(ALL_FAQS),
  ]}
>
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'FAQ' }]} />

  <section>
    <Container class="py-14 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[300px_1fr] lg:items-start">
        <div class="lg:sticky lg:top-20">
          <SectionHeading eyebrow="FAQ" title="Everything students ask us">
            <p>
              Can’t see your question? A real advisor answers {site.responseTime}.
            </p>
          </SectionHeading>
          <nav class="mt-6 hidden space-y-1 lg:block" aria-label="FAQ sections">
            {
              FAQ_CATEGORIES.map((c, i) => (
                <a
                  href={`#faq-${i}`}
                  class="block rounded-lg px-3 py-2 text-sm font-medium text-navy-600 hover:bg-navy-50 hover:text-navy-900"
                >
                  {c.title}
                </a>
              ))
            }
          </nav>
          <div class="mt-6 flex flex-col gap-2">
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700"
            >
              <Icon name="sparkles" size={15} /> Ask us anything
            </a>
            <a
              href={waHref}
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-navy-200 px-4 py-2.5 text-sm font-semibold text-navy-900 hover:bg-navy-50"
            >
              <Icon name="whatsapp" size={16} /> WhatsApp
            </a>
          </div>
        </div>

        <div class="space-y-10">
          {
            FAQ_CATEGORIES.map((c, i) => (
              <div id={`faq-${i}`} class="scroll-mt-24">
                <FaqAccordion items={c.items} heading={c.title} name={`faqcat-${i}`} />
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <CtaBanner
    title="Still not sure about something?"
    body="Send it over. We answer questions from students who haven’t booked with us yet just as fast as ones who have — that’s the job."
    primaryLabel="Ask an advisor"
  />
</BaseLayout>
