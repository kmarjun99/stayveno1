---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { getPropertiesByCountry } from '../../lib/properties';
import { breadcrumbSchema, faqSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return destinations.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const properties = await getPropertiesByCountry(d.slug);
const featured = properties.slice(0, 3);

// "the UK" reads better than "United Kingdom" in running prose.
const country = d.slug === 'uk' ? 'the UK' : d.country;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Destinations', path: '/destinations' },
  { name: d.country },
];
---
<BaseLayout
  title={d.seoTitle}
  description={d.seoDescription}
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Destinations', path: '/destinations' },
      { name: d.country, path: `/destinations/${d.slug}` },
    ]),
    ...(d.faqs.length ? [faqSchema(d.faqs)] : []),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy-950 text-white">
    <PlaceholderImage
      preset="city"
      seed={d.slug}
      src={d.heroImage.startsWith('/') || d.heroImage.startsWith('http') ? d.heroImage : undefined}
      alt={d.heroImageAlt ?? `Student cities in ${d.country}`}
      loading="eager"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-navy-950/70 via-navy-950/80 to-navy-950"></div>
    {
      d.heroImageCredit && (
        <span class="absolute bottom-2 right-3 z-10 text-[10px] text-white/40">
          {d.heroImageCredit}
        </span>
      )
    }
    <Container class="py-14 sm:py-18">
      <p class="flex items-center gap-2 text-sm font-semibold text-brand-300">
        <span class="text-xl">{d.flag}</span> {d.country}
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-extrabold leading-tight sm:text-4xl lg:text-5xl">
        Student accommodation in {country}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/80">{d.intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button href={`/properties?country=${d.slug}`} variant="primary">
          <Icon name="search" size={16} /> See {country} homes
        </Button>
        <Button href="/contact" variant="white">Get a free shortlist</Button>
      </div>
      <p class="mt-5 text-sm text-white/70">
        From <span class="font-semibold text-white">{d.currency}{d.fromPricePerWeek}/week</span>,
        all-in. Video tour on every listing.
      </p>
    </Container>
  </section>

  <!-- Highlights -->
  {
    d.highlights.length > 0 && (
      <section class="border-b border-navy-900/10 bg-navy-50/60">
        <Container class="py-10">
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {d.highlights.map((h) => (
              <li class="flex items-start gap-2.5 text-sm text-navy-700">
                <Icon name="check-circle" size={18} class="mt-0.5 shrink-0 text-brand-600" />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  <!-- Intro prose -->
  <section>
    <Container class="grid gap-10 py-14 lg:grid-cols-[1.5fr_1fr]">
      <div class="rich max-w-none text-navy-700">
        <Content />
      </div>
      <aside class="h-max rounded-2xl border border-navy-900/10 bg-navy-50/60 p-6">
        <h2 class="text-sm font-bold uppercase tracking-[0.14em] text-brand-700">
          At a glance
        </h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-navy-500">Cities covered</dt>
            <dd class="font-semibold text-navy-900">{d.cities.length}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-navy-500">From</dt>
            <dd class="font-semibold text-navy-900">{d.currency}{d.fromPricePerWeek}/week</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-navy-500">Verified homes listed</dt>
            <dd class="font-semibold text-navy-900">{properties.length}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-navy-500">Video tour</dt>
            <dd class="font-semibold text-navy-900">Every listing</dd>
          </div>
        </dl>
        <a
          href={`/properties?country=${d.slug}`}
          class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:gap-2"
        >
          Browse all {country} homes <Icon name="arrow-right" size={15} />
        </a>
      </aside>
    </Container>
  </section>

  <!-- Cities -->
  <section class="bg-navy-50/60">
    <Container class="py-14 sm:py-16">
      <SectionHeading eyebrow="Cities & universities" title={`Where students live in ${country}`} />
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          d.cities.map((city) => (
            <article class="flex flex-col rounded-2xl border border-navy-900/10 bg-white p-6">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-lg font-bold text-navy-900">{city.name}</h3>
                {city.fromPricePerWeek && (
                  <span class="text-sm font-semibold text-brand-700">
                    from {d.currency}{city.fromPricePerWeek}/wk
                  </span>
                )}
              </div>
              {city.blurb && <p class="mt-2 text-sm text-navy-600">{city.blurb}</p>}
              {city.universities.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {city.universities.map((u) => (
                    <li class="rounded-full bg-navy-50 px-2.5 py-1 text-xs font-medium text-navy-700">
                      {u}
                    </li>
                  ))}
                </ul>
              )}
              <a
                href={`/properties?country=${d.slug}&city=${encodeURIComponent(city.name)}`}
                class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:gap-2"
              >
                See homes in {city.name} <Icon name="arrow-right" size={15} />
              </a>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Featured properties -->
  {
    featured.length > 0 && (
      <section>
        <Container class="py-14 sm:py-16">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHeading eyebrow="Verified homes" title={`Featured student homes in ${country}`} />
            <Button href={`/properties?country=${d.slug}`} variant="outline" size="sm">
              View all {properties.length}
            </Button>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((p) => <PropertyCard property={p} />)}
          </div>
        </Container>
      </section>
    )
  }

  <!-- Arrival notes -->
  {
    d.arrivalNotes.length > 0 && (
      <section class="bg-navy-950 text-white">
        <Container class="py-14 sm:py-16">
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">
              Before you arrive
            </p>
            <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
              What to sort out in {country}
            </h2>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-2">
            {d.arrivalNotes.map((note) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <h3 class="font-semibold text-white">{note.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-white/70">{note.body}</p>
              </div>
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <!-- FAQs -->
  {
    d.faqs.length > 0 && (
      <section>
        <Container class="py-14 sm:py-16">
          <div class="grid gap-10 lg:grid-cols-[0.9fr_1.4fr]">
            <SectionHeading eyebrow="FAQ" title={`Renting in ${country}`}>
              <p>
                More on our <a href="/faq" class="font-semibold text-brand-700 underline">main FAQ page</a>.
              </p>
            </SectionHeading>
            <FaqAccordion items={d.faqs} name={`faq-${d.slug}`} />
          </div>
        </Container>
      </section>
    )
  }

  <CtaBanner
    title={`Studying in ${country}? Let’s find your room.`}
    primaryLabel={`Get a ${country} shortlist`}
  />
</BaseLayout>
