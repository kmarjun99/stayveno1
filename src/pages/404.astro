---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SearchBar from '../components/SearchBar.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

const links = [
  { label: 'All properties', href: '/properties' },
  { label: 'Destinations', href: '/destinations' },
  { label: 'How it works', href: '/how-it-works' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
];
---
<BaseLayout
  title="Page Not Found | Stay Veno"
  description="That page doesn’t exist. Search for student accommodation or head back home."
  noindex={true}
>
  <section>
    <Container size="narrow" class="py-16 sm:py-24 text-center">
      <p class="text-6xl font-extrabold text-brand-600">404</p>
      <h1 class="mt-4 text-2xl font-bold text-navy-900 sm:text-3xl">
        We can’t find that page
      </h1>
      <p class="mx-auto mt-3 max-w-md text-navy-600">
        It may have moved. Try searching for your city or university, or use one
        of the links below.
      </p>

      <SearchBar class="mx-auto mt-8 max-w-xl" size="md" />

      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="rounded-full border border-navy-200 px-4 py-2 text-sm font-medium text-navy-700 hover:border-navy-900 hover:text-navy-900"
            >
              {l.label}
            </a>
          ))
        }
      </div>

      <div class="mt-10">
        <Button href="/" variant="primary">
          <Icon name="home" size={16} /> Back to home
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
