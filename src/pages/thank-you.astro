---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { site } from '../config';

const steps = [
  {
    icon: 'search',
    title: 'We check availability',
    body: 'An advisor confirms which of your options are still open for your dates and price.',
  },
  {
    icon: 'list',
    title: 'You get a shortlist',
    body: `Three to five verified homes with video tours, sent ${site.responseTime}, by email and WhatsApp.`,
  },
  {
    icon: 'video',
    title: 'You see the room',
    body: 'Watch the tours, then book a live walkthrough of any you like before deciding.',
  },
];
---
<BaseLayout
  title="Thanks — Your Request Is In | Stay Veno"
  description="Your student accommodation request has been received. An advisor will be in touch shortly."
  noindex={true}
>
  <section>
    <Container size="narrow" class="py-16 sm:py-24 text-center">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-brand-50 text-brand-700">
        <Icon name="check-circle" size={34} />
      </span>
      <h1 class="mt-6 text-3xl font-extrabold text-navy-900 sm:text-4xl">
        Got it — your request is in
      </h1>
      <p class="mx-auto mt-4 max-w-lg text-navy-600">
        Thanks. A Stay Veno advisor will be in touch {site.responseTime}, by
        email and on WhatsApp if you gave us a number. Nothing to pay, nothing
        committed.
      </p>

      <div class="mt-10 grid gap-4 text-left sm:grid-cols-3">
        {
          steps.map((s, i) => (
            <div class="rounded-2xl border border-navy-900/10 bg-white p-5">
              <div class="flex items-center gap-2">
                <span class="grid h-9 w-9 place-items-center rounded-xl bg-navy-950 text-white">
                  <Icon name={s.icon} size={16} />
                </span>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-700">
                  Step {i + 1}
                </span>
              </div>
              <h2 class="mt-3 text-sm font-semibold text-navy-900">{s.title}</h2>
              <p class="mt-1 text-sm text-navy-600">{s.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <Button href="/properties" variant="primary">Keep browsing homes</Button>
        <Button href={`https://wa.me/${site.whatsapp.number}`} variant="outline">
          <Icon name="whatsapp" size={17} /> Message us now
        </Button>
      </div>

      <div class="mt-12 text-left">
        <NewsletterSignup variant="card" />
      </div>
    </Container>
  </section>
</BaseLayout>
