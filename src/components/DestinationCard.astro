---
import type { Destination } from '../lib/properties';
import PlaceholderImage from './PlaceholderImage.astro';
import Icon from './Icon.astro';

interface Props {
  destination: Destination;
  size?: 'sm' | 'lg';
}
const { destination, size = 'sm' } = Astro.props;
const d = destination.data;
const href = `/destinations/${d.slug}`;
const cityNames = d.cities.map((c) => c.name).join(' · ');
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-2xl border border-navy-900/10 bg-white shadow-sm transition-shadow hover:shadow-lg"
>
  <div class={size === 'lg' ? 'aspect-[16/10]' : 'aspect-[16/9]'}>
    <PlaceholderImage
      preset="city"
      seed={d.slug}
      src={d.heroImage?.startsWith('/') || d.heroImage?.startsWith('http') ? d.heroImage : undefined}
      alt={d.heroImageAlt ?? `Student cities in ${d.country}`}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2">
      <span class="text-2xl leading-none">{d.flag}</span>
      <h3 class="text-lg font-bold text-navy-900">{d.country}</h3>
    </div>
    <p class="mt-1 text-sm font-medium text-brand-700">
      From {d.currency}{d.fromPricePerWeek}/week
    </p>
    <p class="mt-2 line-clamp-2 text-sm text-navy-600">{cityNames}</p>
    <span
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 group-hover:gap-2"
    >
      Explore {d.country} <Icon name="arrow-right" size={15} />
    </span>
  </div>
</a>
