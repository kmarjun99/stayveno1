---
import { site } from '../config';
import Icon from './Icon.astro';

interface Props {
  variant?: 'card' | 'compact' | 'inline';
  class?: string;
}
const { variant = 'card', class: className = '' } = Astro.props;
const endpoint = site.newsletterEndpoint;
---
{
  variant === 'compact' ? (
    <form
      class={`newsletter-form flex w-full max-w-sm flex-col gap-2 ${className}`}
      action={endpoint || '#'}
      method="POST"
      data-demo={endpoint ? undefined : 'true'}
    >
      <label for="nl-email-compact" class="text-sm font-medium text-white/90">
        Get the free International Student Housing Checklist
      </label>
      <div class="flex gap-2">
        <input
          id="nl-email-compact"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@email.com"
          class="min-w-0 flex-1 rounded-full border border-white/20 bg-white/10 px-4 py-2.5 text-sm text-white placeholder:text-white/50 focus:border-white/50 focus:bg-white/15 focus:outline-none"
        />
        <button
          type="submit"
          class="shrink-0 rounded-full bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition-colors hover:bg-brand-100"
        >
          Send it
        </button>
      </div>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <p class="newsletter-status text-sm text-brand-200" role="status" hidden />
      <p class="text-xs text-white/50">No spam. One useful email a month. Unsubscribe anytime.</p>
    </form>
  ) : (
    <div
      class={`overflow-hidden rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-6 sm:p-8 ${className}`}
    >
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-md">
          <span class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-800">
            <Icon name="document" size={14} /> Free download
          </span>
          <h3 class="mt-3 text-xl font-bold text-navy-900 sm:text-2xl">
            The International Student Housing Checklist
          </h3>
          <p class="mt-2 text-sm text-navy-700">
            32 things to check before you pay a deposit abroad — scam red flags,
            contract clauses that matter, deposit protection by country, and the
            questions to ask on a video viewing.
          </p>
        </div>
        <form
          class="newsletter-form flex w-full max-w-xs flex-col gap-2 sm:shrink-0"
          action={endpoint || '#'}
          method="POST"
          data-demo={endpoint ? undefined : 'true'}
        >
          <label for="nl-email-card" class="sr-only">Email address</label>
          <input
            id="nl-email-card"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@email.com"
            class="w-full rounded-full border border-navy-200 bg-white px-4 py-3 text-sm text-navy-900 placeholder:text-navy-400 focus:border-brand-500 focus:outline-none"
          />
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button
            type="submit"
            class="rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Email me the checklist
          </button>
          <p class="newsletter-status text-sm text-brand-700" role="status" hidden />
          <p class="text-xs text-navy-500">
            We’ll also send occasional housing tips. Unsubscribe anytime.
          </p>
        </form>
      </div>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLFormElement>('.newsletter-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      const status = form.querySelector<HTMLElement>('.newsletter-status');
      const honey = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
      if (honey && honey.value) {
        e.preventDefault();
        return;
      }
      const isDemo = form.dataset.demo === 'true';
      if (isDemo) {
        e.preventDefault();
      } else {
        e.preventDefault();
        try {
          await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
        } catch {
          /* fall through to success message anyway */
        }
      }
      form.reset();
      if (status) {
        status.hidden = false;
        status.textContent =
          '✓ Check your inbox — the checklist is on its way.';
      }
    });
  });
</script>
