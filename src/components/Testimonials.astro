---
import { TESTIMONIALS } from '../data/testimonials';
import Icon from './Icon.astro';

interface Props {
  limit?: number;
  class?: string;
}
const { limit = 3, class: className = '' } = Astro.props;
const items = TESTIMONIALS.slice(0, limit);
---
<div class={`grid gap-5 md:grid-cols-3 ${className}`}>
  {
    items.map((t) => (
      <figure class="flex flex-col rounded-2xl border border-navy-900/10 bg-white p-6 shadow-sm">
        <div class="flex gap-0.5 text-sun-500" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <Icon name="star" size={15} />
          ))}
        </div>
        <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-navy-700">
          “{t.quote}”
        </blockquote>
        <figcaption class="mt-4 border-t border-navy-900/10 pt-4">
          <p class="text-sm font-semibold text-navy-900">{t.name}</p>
          <p class="text-xs text-navy-500">
            {t.course}, {t.university}
          </p>
          <p class="mt-0.5 text-xs text-brand-700">{t.from}</p>
        </figcaption>
      </figure>
    ))
  }
</div>
