---
import Container from './Container.astro';

interface Props {
  items: { name: string; path?: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---
<nav aria-label="Breadcrumb" class={`border-b border-navy-900/10 bg-navy-50/60 ${className}`}>
  <Container class="py-3">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-navy-500">
      {
        items.map((item, i) => (
          <li class="flex items-center gap-1.5">
            {item.path && i < items.length - 1 ? (
              <a href={item.path} class="hover:text-brand-700 hover:underline">
                {item.name}
              </a>
            ) : (
              <span class="font-medium text-navy-800" aria-current="page">
                {item.name}
              </span>
            )}
            {i < items.length - 1 && <span aria-hidden="true">/</span>}
          </li>
        ))
      }
    </ol>
  </Container>
</nav>
