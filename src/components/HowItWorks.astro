---
import { STEPS } from '../data/steps';
import Icon from './Icon.astro';

interface Props {
  variant?: 'compact' | 'full';
  class?: string;
}
const { variant = 'compact', class: className = '' } = Astro.props;
---
{
  variant === 'compact' ? (
    <ol class={`grid gap-4 sm:grid-cols-2 lg:grid-cols-4 ${className}`}>
      {STEPS.map((step) => (
        <li class="relative rounded-2xl border border-navy-900/10 bg-white p-5">
          <div class="flex items-center gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-navy-950 text-white">
              <Icon name={step.icon} size={18} />
            </span>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-700">
              Step {step.n}
            </span>
          </div>
          <h3 class="mt-3 font-semibold text-navy-900">{step.title}</h3>
          <p class="mt-1 text-sm text-navy-600">{step.short}</p>
        </li>
      ))}
    </ol>
  ) : (
    <ol class={`space-y-6 ${className}`}>
      {STEPS.map((step) => (
        <li class="grid gap-5 rounded-2xl border border-navy-900/10 bg-white p-6 sm:grid-cols-[auto_1fr] sm:p-8">
          <div class="flex items-start gap-4 sm:flex-col sm:items-center sm:gap-3">
            <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-navy-950 text-white">
              <Icon name={step.icon} size={24} />
            </span>
            <span class="text-sm font-bold uppercase tracking-wider text-brand-700 sm:text-center">
              Step {step.n}
            </span>
          </div>
          <div>
            <h3 class="text-xl font-bold text-navy-900">{step.title}</h3>
            <p class="mt-2 text-navy-600">{step.detail}</p>
            <ul class="mt-4 grid gap-2 sm:grid-cols-3">
              {step.points.map((p) => (
                <li class="flex items-start gap-2 text-sm text-navy-700">
                  <Icon name="check-circle" size={16} class="mt-0.5 shrink-0 text-brand-600" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  )
}
