---
import { site } from '../config';
import Icon from './Icon.astro';

const message = "Hi Stay Veno, I'm looking for student accommodation and have a few questions.";
const waHref = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(message)}`;
---
<div class="fixed bottom-5 right-5 z-50 hidden sm:block">
  <div
    id="wa-panel"
    hidden
    class="mb-3 w-80 overflow-hidden rounded-2xl border border-navy-900/10 bg-white shadow-2xl shadow-navy-950/20"
  >
    <div class="flex items-center gap-3 bg-navy-950 px-4 py-3 text-white">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-500">
        <Icon name="chat" size={18} />
      </span>
      <div>
        <p class="text-sm font-semibold">Stay Veno advisors</p>
        <p class="text-xs text-white/60">Typically reply {site.responseTime}</p>
      </div>
    </div>
    <div class="space-y-3 p-4">
      <p class="text-sm text-navy-700">
        Tell us your university and move-in date and we’ll start your search. No
        cost, no obligation.
      </p>
      <a
        href={waHref}
        rel="noopener"
        class="flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-4 py-2.5 text-sm font-semibold text-white hover:brightness-95"
      >
        <Icon name="whatsapp" size={18} /> Chat on WhatsApp
      </a>
      <a
        href={`mailto:${site.email}`}
        class="flex items-center justify-center gap-2 rounded-full border border-navy-200 px-4 py-2.5 text-sm font-semibold text-navy-900 hover:bg-navy-50"
      >
        <Icon name="mail" size={16} /> Email us instead
      </a>
      <a
        href="/contact"
        class="block text-center text-xs font-medium text-brand-700 hover:underline"
      >
        Or fill in the quick form →
      </a>
    </div>
  </div>

  <button
    type="button"
    id="wa-toggle"
    aria-expanded="false"
    aria-controls="wa-panel"
    class="flex items-center gap-2.5 rounded-full bg-navy-950 py-3 pl-3 pr-5 text-sm font-semibold text-white shadow-xl shadow-navy-950/25 transition-transform hover:-translate-y-0.5"
  >
    <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-500">
      <Icon name="chat" size={16} />
    </span>
    Chat with an advisor
  </button>
</div>

<script>
  const toggle = document.getElementById('wa-toggle');
  const panel = document.getElementById('wa-panel');
  if (toggle && panel) {
    const close = () => {
      panel.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = panel.hasAttribute('hidden');
      if (isHidden) {
        panel.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        close();
      }
    });
    document.addEventListener('click', (e) => {
      if (
        !panel.hasAttribute('hidden') &&
        e.target instanceof Node &&
        !panel.contains(e.target) &&
        !toggle.contains(e.target)
      ) {
        close();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
