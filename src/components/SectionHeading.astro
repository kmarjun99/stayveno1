---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  class?: string;
  as?: 'h2' | 'h3';
}
const {
  eyebrow,
  title,
  align = 'left',
  class: className = '',
  as: Tag = 'h2',
} = Astro.props;
const alignCls = align === 'center' ? 'text-center mx-auto' : '';
---
<div class={`max-w-2xl ${alignCls} ${className}`}>
  {
    eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">
        {eyebrow}
      </p>
    )
  }
  <Tag
    class="mt-2 text-2xl font-bold text-navy-900 sm:text-3xl md:text-[2rem] md:leading-tight"
  >
    {title}
  </Tag>
  {
    Astro.slots.has('default') && (
      <div class="mt-3 text-navy-600">
        <slot />
      </div>
    )
  }
</div>
